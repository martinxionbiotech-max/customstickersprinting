---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CtaBand from "../../components/CtaBand.astro";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const articles = await getCollection("knowledge");
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}

interface Props { article: CollectionEntry<"knowledge">; }
const { article } = Astro.props;
const d = article.data;
const { Content } = await render(article);

const PILLAR_TITLES: Record<string, string> = {
  "label-materials": "Label materials and adhesives",
  "sticker-materials": "Sticker materials and cutting",
  printing: "Printing and production",
  artwork: "Artwork preparation",
  procurement: "MOQ, pricing and ordering",
};

const all = await getCollection("knowledge");
const siblings = all.filter((a) => a.data.pillar === d.pillar).sort((a, b) => a.data.order - b.data.order);
const pos = siblings.findIndex((a) => a.id === article.id);
const prev = pos > 0 ? siblings[pos - 1] : null;
const next = pos >= 0 && pos < siblings.length - 1 ? siblings[pos + 1] : null;

const myTags = new Set(d.relatedProducts);
const relatedReading = all
  .filter((a) => a.id !== article.id && a.data.pillar !== d.pillar)
  .map((a) => ({ a, score: a.data.relatedProducts.filter((r) => myTags.has(r)).length }))
  .filter((x) => x.score > 0)
  .sort((x, y) => y.score - x.score)
  .slice(0, 3)
  .map((x) => x.a);

const products = await getCollection("products");
const related = d.relatedProducts.map((s) => products.find((p) => p.id === s)).filter((p): p is CollectionEntry<"products"> => Boolean(p));

const ld = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: d.title,
  description: d.description,
  datePublished: "2026-11-01",
  dateModified: `${d.updated}-01`,
  author: { "@type": "Organization", name: site.brand },
  publisher: { "@id": `${site.url}/#organization` },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  ...(d.sources.length > 0 ? { citation: d.sources.map((s) => s.url) } : {}),
};

const faqLd = d.faq.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: d.faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;
---

<BaseLayout title={d.title} description={d.description} type="article" jsonLd={faqLd ? [ld, faqLd] : [ld]} alternateMd={`/knowledge/${article.id}/index.md`}>
  <Breadcrumbs items={[{ label: "Knowledge", href: "/knowledge/" }, { label: PILLAR_TITLES[d.pillar], href: "/knowledge/" }, { label: d.title }]} />
  <section class="tight">
    <div class="wrap narrow">
      <p class="eyebrow">{PILLAR_TITLES[d.pillar]}</p>
      <h1>{d.title}</h1>
      <p style="font-size:1.06rem;color:var(--ink-2)">{d.description}</p>
      <p class="small">Updated {d.updated}</p>

      {d.view && (
        <aside class="our-view">
          <p class="eyebrow" style="margin:0 0 6px">Our view</p>
          <p style="margin:0">{d.view}</p>
        </aside>
      )}

      <div class="prose" style="margin-top:26px"><Content /></div>

      {d.faq.length > 0 && (
        <section style="margin-top:38px;border-top:1px solid var(--line);padding-top:26px">
          <h2 style="font-size:1.25rem">Quick answers</h2>
          {d.faq.map((f) => (
            <div style="margin-top:18px">
              <h3 style="font-size:1rem;margin:0 0 4px">{f.q}</h3>
              <p style="margin:0;color:var(--ink-2)">{f.a}</p>
            </div>
          ))}
        </section>
      )}

      {d.sources.length > 0 && (
        <section style="margin-top:34px;border-top:1px solid var(--line);padding-top:20px">
          <h2 style="font-size:1rem;color:var(--ink-3)">Sources</h2>
          <ul class="small" style="margin:8px 0 0;padding-left:18px;line-height:1.7">
            {d.sources.map((s) => (
              <li><a href={s.url} rel="noopener">{s.label}</a></li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </section>

  {related.length > 0 && (
    <section class="tight" style="background:var(--bg-2);border-top:1px solid var(--line)">
      <div class="wrap">
        <h2>Products this applies to</h2>
        <div class="grid grid-3" style="margin-top:14px">
          {related.map((p) => (
            <a class="card" href={`/${p.id}/`}>
              <h3>{p.data.title}</h3>
              <p>{p.data.description.slice(0, 100)}…</p>
              <span class="more">View product →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {relatedReading.length > 0 && (
    <section class="tight" style="background:var(--bg-2);border-top:1px solid var(--line)">
      <div class="wrap narrow">
        <h2>Related reading</h2>
        <ul style="margin-top:12px;line-height:2">
          {relatedReading.map((r) => (
            <li><a href={`/knowledge/${r.id}/`}>{r.data.title}</a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {(prev || next) && (
    <section class="tight">
      <div class="wrap narrow" style="display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap">
        {prev ? <a href={`/knowledge/${prev.id}/`}>← {prev.data.title}</a> : <span />}
        {next ? <a href={`/knowledge/${next.id}/`} style="text-align:right">{next.data.title} →</a> : <span />}
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>
