---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CtaBand from "../../components/CtaBand.astro";
import { PILLARS as PILLAR_DATA, PILLAR_ORDER } from "../../data/pillars";

const articles = await getCollection("knowledge");
const INTROS: Record<string, string> = {
  "label-sizing": "How to measure a container, choose a size, and calculate a wrap.",
  "label-cost": "What drives a label price, what the setup covers, and how many to order.",
  "marketplace-labels": "FNSKU, suffocation warnings, barcodes and what retail actually requires.",
  "label-materials": "Paper, PP, PET, adhesive and the conditions each one survives.",
  "sticker-materials": "Vinyl versus paper, die cut versus kiss cut, and what a finish actually does.",
  printing: "Digital versus flexo, how a roll is made, and where the crossover sits.",
  artwork: "Colour, bleed, safe area and the files that print without surprises.",
  "hang-tags": "Card weight, hole placement, eyelets, string and the finishes that survive handling.",
  "label-compliance": "Mandatory fields, market differences and the limits of a print supplier's review.",
};
const TITLES: Record<string, string> = {
  "label-sizing": "Label sizing and dimensions",
  "label-cost": "Cost and ordering",
  "marketplace-labels": "Marketplace and retail labels",
  "label-materials": "Label materials and adhesives",
  "sticker-materials": "Sticker materials and cutting",
  printing: "Printing and production",
  artwork: "Artwork preparation",
  "hang-tags": "Hang tags and printed card",
  "label-compliance": "Label compliance",
};
const groups = PILLAR_ORDER.map((key) => ({
  key,
  title: TITLES[key] ?? PILLAR_DATA[key].title,
  intro: INTROS[key] ?? PILLAR_DATA[key].description,
  items: articles.filter((a) => a.data.pillar === key).sort((a, b) => a.data.order - b.data.order),
}));
---

<BaseLayout title="Knowledge base: labels, stickers and print production" description="Technical background on label materials, sticker formats, printing methods, artwork preparation and MOQ — written for buyers rather than printers.">
  <Breadcrumbs items={[{ label: "Knowledge" }]} />
  <section class="tight">
    <div class="wrap">
      <h1>Knowledge base</h1>
      <p style="max-width:68ch;color:var(--ink-2);font-size:1.05rem">
        Background on the decisions behind a label order: which material survives your product,
        which format suits your quantity, and what in the artwork causes reprints.
        Written for buyers, not for printers.
      </p>

      {groups.map((g) => (
        <section style="padding:34px 0 0">
          <h2><a href={`/knowledge/${g.key}/`}>{g.title}</a></h2>
          <p style="color:var(--ink-3);max-width:60ch">{g.intro}</p>
          <div class="grid grid-3" style="margin-top:16px">
            {g.items.map((a) => (
              <a class="card" href={`/knowledge/${a.id}/`}>
                <h3>{a.data.title}</h3>
                <p>{a.data.description}</p>
                <span class="more">Read →</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
  <CtaBand heading="Have a specification you are unsure about?" body="Send the product, the container and the storage condition. We will tell you which material and format actually fit — before you order." />
</BaseLayout>
