---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The page you were looking for does not exist. Browse labels, stickers or contact us for a quotation." noindex>
  <section class="tight">
    <div class="wrap narrow prose">
      <h1>Page not found</h1>
      <p>The page you asked for does not exist. It may have moved, or the address may be mistyped.</p>
      <p>
        <a class="btn btn-primary" href="/">Home</a>
        <a class="btn btn-secondary" href="/products/">All products</a>
      </p>
      <p style="margin-top:24px">Looking for something specific? <a href="/contact/">Tell us what you need</a> and we will point you to it.</p>
    </div>
  </section>
</BaseLayout>
