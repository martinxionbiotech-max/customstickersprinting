---
import { productImage } from "../lib/media";

interface Props {
  slug: string;
  alt: string;
  label?: string;
  width?: number;
  height?: number;
  eager?: boolean;
}

const { slug, alt, label, width = 1200, height = 900, eager = false } = Astro.props;
const src = productImage(slug);
---

{src ? (
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    style="width:100%;height:auto;border-radius:10px;border:1px solid var(--line)"
  />
) : (
  <div
    style="aspect-ratio:4/3;width:100%;border-radius:10px;border:1px dashed var(--line);background:var(--bg-2);display:flex;flex-direction:column;justify-content:center;gap:10px;padding:28px;box-sizing:border-box"
    role="img"
    aria-label={`Photograph pending for ${label ?? alt}`}
  >
    <span class="eyebrow" style="margin:0">Photograph pending</span>
    <strong style="font-size:1.05rem;line-height:1.35">{label ?? "Product sample"}</strong>
    <span class="small" style="line-height:1.5">{alt}</span>
    <span class="small" style="line-height:1.45;color:var(--ink-3)">This slot is reserved for a real sample photograph. No AI mock-up is used.</span>
  </div>
)}
