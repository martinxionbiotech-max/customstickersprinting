---
import { productImage } from "../lib/media";

interface Props {
  slug: string;
  alt: string;
  label?: string;
  width?: number;
  height?: number;
  eager?: boolean;
}

const { slug, alt, label, width = 1200, height = 900, eager = false } = Astro.props;
const src = productImage(slug);
---

{src ? (
  <figure class="schematic-figure">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
    <figcaption>
      <strong>Industrial schematic — not a photograph.</strong> Customer print work is not shown without
      written permission. <a href="/declarations/#photography">Photography policy</a>.
    </figcaption>
  </figure>
) : (
  <div class="schematic-figure schematic-fallback" role="img" aria-label={`Schematic pending for ${label ?? alt}`}>
    <span class="eyebrow" style="margin:0">Schematic pending</span>
    <strong style="font-size:1.05rem;line-height:1.35">{label ?? "Product schematic"}</strong>
    <span class="small" style="line-height:1.5">{alt}</span>
  </div>
)}
