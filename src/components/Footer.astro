---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a href="/" class="brand">{site.brand}</a>
        <p style="margin-top:10px;max-width:34ch">
          Custom labels and stickers for growing brands. Small batch production from {site.moq} units,
          personal quotations, worldwide delivery.
        </p>
        <p>
          <a href={`mailto:${site.email}`}>{site.email}</a><br />
          <a href={`https://wa.me/${site.whatsapp}`}>WhatsApp {site.whatsappDisplay}</a>
        </p>
      </div>
      <div>
        <h4>Labels</h4>
        <ul>
          <li><a href="/custom-labels/">Custom labels</a></li>
          <li><a href="/roll-labels/">Roll labels</a></li>
          <li><a href="/bottle-labels/">Bottle labels</a></li>
          <li><a href="/cosmetic-labels/">Cosmetic labels</a></li>
          <li><a href="/food-labels/">Food labels</a></li>
        </ul>
      </div>
      <div>
        <h4>Stickers</h4>
        <ul>
          <li><a href="/custom-stickers/">Custom stickers</a></li>
          <li><a href="/vinyl-stickers/">Vinyl stickers</a></li>
          <li><a href="/logo-stickers/">Logo stickers</a></li>
          <li><a href="/die-cut-stickers/">Die cut stickers</a></li>
          <li><a href="/sticker-sheets/">Sticker sheets</a></li>
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/about/">About us</a></li>
          <li><a href="/knowledge/">Knowledge base</a></li>
          <li><a href="/how-to-order/">How to order</a></li>
          <li><a href="/artwork-guidelines/">Artwork guidelines</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} {site.brand}. All rights reserved.</span>
      <span>
        <a href="/privacy/">Privacy</a> ·
        <a href="/terms/">Terms</a> ·
        <a href="/shipping-delivery/">Shipping</a>
      </span>
    </div>
  </div>
</footer>
